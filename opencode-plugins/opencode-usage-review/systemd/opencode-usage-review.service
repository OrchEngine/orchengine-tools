Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=XDG_STATE_HOME=%h/.local/state
ExecStart=%h/Projects/orchengine-tools/opencode-plugins/opencode-usage-review/scripts/daily-report.sh yesterday
