#!/usr/bin/env bash
# cg: render a static call graph for a Go module.
# usage: cg [-a static|cha|rta|vta] [-f focus] [-o out.svg] <package pattern>...
set -euo pipefail

mod=${MODULE:-}
if [ -z "$mod" ]; then
  mod=$(go list -m -f '{{.Path}}' 2>/dev/null) || {
    echo "cg: not inside a Go module" >&2
    exit 1
  }
fi
algo=${ALGO:-cha}
modfile=$(go env GOMOD 2>/dev/null || true)
repo=graph
if [ -n "$modfile" ] && [ "$modfile" != "/dev/null" ]; then
  repo=$(basename "$(dirname "$modfile")")
fi
out=${OUT:-$HOME/Projects/orchengine-tools/go/out/$repo/callgraph.svg}
focus=

while getopts "a:f:o:" opt; do
  case $opt in
    a) algo=$OPTARG ;;
    f) focus=$OPTARG ;;
    o) out=$OPTARG ;;
    *) echo "usage: cg [-a static|cha|rta|vta] [-f focus] [-o out.svg] <pkg>..." >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || { echo "usage: cg [-a static|cha|rta|vta] [-f focus] [-o out.svg] <pkg>..." >&2; exit 2; }

mkdir -p "$(dirname "$out")"
dotfile=${out%.*}.dot

callgraph -algo "$algo" -format '{{.Caller}}|{{.Dynamic}}|{{.Line}}:{{.Column}}|{{.Callee}}' "$@" |
  awk -F'|' -v mod="$mod" -v focus="$focus" '
    (index($1, mod) > 0 && index($4, mod) > 0) && (focus == "" || index($1, focus) || index($4, focus)) {
      callee = $4; sub("^" mod "/", "", callee)
      caller = $1; sub("^" mod "/", "", caller)
      style = ($2 == "dynamic") ? ", style=dashed" : ""
      printf "\"%s\" -> \"%s\" [label=\"%s:%s\"%s];\n", caller, callee, $2, $3, style
    }' > "$dotfile"

{
  echo 'digraph calls {'
  echo '  rankdir=LR;'
  echo '  node [shape=box, style="filled,rounded", fillcolor="#eef2f7", fontname="monospace", fontsize=9];'
  echo '  edge [fontname="monospace", fontsize=7, color="#5b6b7c"];'
  cat "$dotfile"
  echo '}'
} > "$dotfile.tmp" && mv "$dotfile.tmp" "$dotfile"

edges=$(grep -c -- "->" "$dotfile" || true)
dot -Tsvg "$dotfile" -o "$out"
printf 'edges: %s\n' "$edges"
printf 'dot:   %s\nsvg:   %s\n' "$dotfile" "$out"
