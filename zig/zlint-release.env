# Pinned prebuilt zlint release for CI.
#
# Pinned to the published zlint release. Environment variables override these
# defaults, which is useful for local testing with a downloaded artifact.
: "${ZLINT_RELEASE_REPO:=OrchEngine/orchengine-tools}"
: "${ZLINT_RELEASE_TAG:=zlint-v0.10.0-orche.4}"
: "${ZLINT_RELEASE_ASSET:=zlint-linux-x86_64.tar.gz}"
: "${ZLINT_RELEASE_SHA256:=d61db760505d60ec4f947046c521d7e329ea323a792c50898e70ddbfa488be9e}"
