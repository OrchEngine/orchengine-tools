#!/usr/bin/env bash
# Rebuild go-callvis against the latest x/tools so it works with new Go releases.
# Upstream v0.7.1 pins x/tools v0.28, which cannot parse Go 1.27 code.
set -euo pipefail

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

git clone --depth 1 https://github.com/ondrajz/go-callvis "$tmp/go-callvis"
cd "$tmp/go-callvis"
go get golang.org/x/tools@latest
go mod tidy
dest="${TOOLS_BIN:-$HOME/Projects/orchengine-tools/bin}/go-callvis"
mkdir -p "$(dirname "$dest")"
go build -o "$dest" .
"$dest" -version

resolved=$(command -v go-callvis || true)
if [ -n "$resolved" ] && [ "$(readlink -f "$resolved")" != "$(readlink -f "$dest")" ]; then
  echo "note: 'go-callvis' resolves to $resolved, not $dest" >&2
  echo "      point that path at $dest or put $HOME/Projects/orchengine-tools/bin earlier in PATH" >&2
fi
